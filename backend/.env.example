# === Sonus Configuration ===
# Copy this file to .env in the project root and fill in your values.

# LLM Provider — required (any OpenAI-compatible API)
AI_API_KEY=your-api-key-here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o

# Google Calendar ICS feed (read-only, no OAuth needed)
GOOGLE_CALENDAR_ICS_URL=

# Google Calendar OAuth (optional — for creating/editing events)
# Create at https://console.cloud.google.com > APIs & Services > Credentials
# Add redirect URI: http://127.0.0.1:8000/api/gcal/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/gcal/callback

# Canvas LMS ICS feed URL (optional — get from Canvas > Account > Calendar > Calendar Feed)
CANVAS_ICS_URL=

# OpenWeatherMap API key (optional — free tier: https://openweathermap.org/api)
WEATHER_API_KEY=
WEATHER_CITY=Your City

# Ntfy push notifications (free — install ntfy app, pick any topic name)
NTFY_TOPIC=

# FatSecret API (optional — free tier: https://platform.fatsecret.com/api/)
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# Spotify (optional — create app at https://developer.spotify.com/dashboard)
# Add redirect URI in your Spotify app: http://127.0.0.1:8000/api/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/spotify/callback

# Google OAuth covers Gmail (read-only) and Google Tasks — no extra setup needed

# Daily token budget (0 = no limit shown in UI)
DAILY_TOKEN_BUDGET=0

# Database
DATABASE_URL=sqlite+aiosqlite:///./sonus.db

# User info
USER_NAME=User

# Server
HOST=0.0.0.0
PORT=8000
